{
  "name": "flux",
  "productName": "Flux",
  "version": "0.6.0",
  "description": "Flux - streaming app (Electron)",
  "main": "main.js",
  "author": "etb190",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.etb190.flux",
    "productName": "Flux",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "search.js",
      "streams.js",
      "tmdb.js",
      "http.js",
      "providers2.js",
      "providers3.js",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "hls.js": "^1.7.3"
  }
}
