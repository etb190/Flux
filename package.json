{
  "name": "flux",
  "productName": "Flux",
  "version": "0.3.0",
  "description": "Flux - a lightweight streaming app for Windows",
  "main": "main.js",
  "author": "etb190",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.etb190.flux",
    "productName": "Flux",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    }
  }
}
